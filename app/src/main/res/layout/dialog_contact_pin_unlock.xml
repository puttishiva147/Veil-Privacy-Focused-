<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_veil"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- Glowing Icon Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_button_cyber_secondary">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lock_closed"
                app:tint="@color/veil_accent_secure" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvUnlockHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:text="CONTACT PRIVACY LOCK"
                android:textColor="@color/veil_text_high"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvContactTargetSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Independent Contact Authentication"
                android:textColor="@color/veil_accent_secure"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="@color/veil_hairline" />

    <TextView
        android:id="@+id/tvUnlockPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3dp"
        android:text="This contact has an independent PIN lock. Enter the contact's PIN to access their protected conversation."
        android:textColor="@color/veil_text_medium"
        android:textSize="13sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilContactUnlockPin"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Enter Contact PIN"
        android:textColorHint="@color/veil_text_medium"
        app:boxBackgroundColor="@color/veil_surface_card"
        app:boxCornerRadiusBottomEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusTopStart="8dp"
        app:boxStrokeColor="@color/veil_accent_secure"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="1.5dp"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/veil_text_medium"
        app:errorTextColor="@color/veil_accent_danger"
        app:startIconDrawable="@drawable/ic_lock_closed"
        app:startIconTint="@color/veil_accent_secure">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etContactUnlockPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:inputType="numberPassword"
            android:maxLength="8"
            android:maxLines="1"
            android:textColor="@color/veil_text_high"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelUnlock"
            style="@style/Widget.Veil.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="Cancel"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmUnlock"
            style="@style/Widget.Veil.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="Unlock Chat"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
