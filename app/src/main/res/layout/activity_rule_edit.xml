<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/veil_canvas"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/veil_canvas">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarRuleEdit"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/veil_text_high"
            app:title="Configure Protection Rule"
            app:titleTextColor="@color/veil_text_high" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="40dp">

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="1. REAL CONTACT TO PROTECT"
                android:textColor="@color/veil_accent_secure"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Selected Contact Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardContactPicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/veil_surface_card"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/veil_hairline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvSelectedContactName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No contact selected"
                        android:textColor="@color/veil_text_high"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSelectedContactPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="monospace"
                        android:text="Tap below to select a contact"
                        android:textColor="@color/veil_accent_secure"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPickContact"
                            style="@style/Widget.Veil.Button.Primary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="40dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="8dp"
                            android:text="Select from Contacts"
                            android:textSize="12sp"
                            app:icon="@drawable/ic_person_protect"
                            app:iconPadding="4dp"
                            app:iconSize="16dp"
                            app:iconTint="@color/veil_button_primary_text" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnManualContact"
                            style="@style/Widget.Veil.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:minHeight="40dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="10dp"
                            android:text="Manual"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Decoy Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:letterSpacing="0.1"
                android:text="2. DECOY IDENTITY &amp; MESSAGE"
                android:textColor="@color/veil_accent_secure"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Decoy Name Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDecoyIdentity"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:boxBackgroundColor="@color/veil_surface_elevated"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                app:boxStrokeColor="@color/veil_accent_secure"
                app:hintTextColor="@color/veil_accent_secure">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDecoyIdentity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Decoy Name (e.g. Work, Calendar, Cloud Service)"
                    android:inputType="textPersonName"
                    android:textColor="@color/veil_text_high"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Quick Identity Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDecoyDynamic"
                        style="@style/Widget.Veil.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✨ Dynamic (Auto)"
                        android:textColor="@color/veil_accent_secure" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDecoyWork"
                        style="@style/Widget.Veil.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Work"
                        android:textColor="@color/veil_text_high" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDecoyCalendar"
                        style="@style/Widget.Veil.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Calendar"
                        android:textColor="@color/veil_text_high" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDecoyDelivery"
                        style="@style/Widget.Veil.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Delivery"
                        android:textColor="@color/veil_text_high" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDecoySystem"
                        style="@style/Widget.Veil.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="System Alert"
                        android:textColor="@color/veil_text_high" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Decoy Notification Text Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDecoyMessage"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:boxBackgroundColor="@color/veil_surface_elevated"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                app:boxStrokeColor="@color/veil_accent_secure"
                app:hintTextColor="@color/veil_accent_secure">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDecoyMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Decoy Notification Text (e.g. New message, Task reminder)"
                    android:inputType="textCapSentences"
                    android:textColor="@color/veil_text_high"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Quick Message Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMsgNewMessage"
                        style="@style/Widget.Veil.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New message"
                        android:textColor="@color/veil_text_high" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMsgTask"
                        style="@style/Widget.Veil.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Task reminder"
                        android:textColor="@color/veil_text_high" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMsgSync"
                        style="@style/Widget.Veil.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Sync completed"
                        android:textColor="@color/veil_text_high" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMsgDoc"
                        style="@style/Widget.Veil.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Document shared"
                        android:textColor="@color/veil_text_high" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Live Preview Card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.1"
                android:text="REPLACEMENT NOTIFICATION PREVIEW"
                android:textColor="@color/veil_text_low"
                android:textSize="10sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="@color/veil_surface_elevated"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/veil_hairline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_circle_icon"
                        android:padding="6dp"
                        android:src="@drawable/ic_veil_notification"
                        app:tint="@color/veil_accent_secure" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPreviewTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Work"
                            android:textColor="@color/veil_text_high"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPreviewBody"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="New message"
                            android:textColor="@color/veil_text_medium"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 3: Notification Behavior -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:letterSpacing="0.1"
                android:text="3. NOTIFICATION BEHAVIOR"
                android:textColor="@color/veil_accent_secure"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/veil_surface_card"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/veil_hairline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_toStartOf="@id/switchRuleSound"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sound Notification"
                                android:textColor="@color/veil_text_high"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Play alert tone when disguised event arrives"
                                android:textColor="@color/veil_text_low"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchRuleSound"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:checked="true" 
                            app:thumbTint="@color/veil_switch_thumb"
                            app:trackTint="@color/veil_switch_track" />
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/veil_hairline" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_toStartOf="@id/switchRuleVibration"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vibration Alert"
                                android:textColor="@color/veil_text_high"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vibrate device when disguised event arrives"
                                android:textColor="@color/veil_text_low"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchRuleVibration"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:checked="true" 
                            app:thumbTint="@color/veil_switch_thumb"
                            app:trackTint="@color/veil_switch_track" />
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/veil_hairline" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_toStartOf="@id/switchRuleCallDisguise"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="WhatsApp Voice/Video Calls"
                                android:textColor="@color/veil_text_high"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Disguise incoming call notifications"
                                android:textColor="@color/veil_text_low"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchRuleCallDisguise"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:checked="true" 
                            app:thumbTint="@color/veil_switch_thumb"
                            app:trackTint="@color/veil_switch_track" />
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/veil_hairline" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_toStartOf="@id/switchRuleActive"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rule Active"
                                android:textColor="@color/veil_text_high"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Enable or temporarily pause this protection rule"
                                android:textColor="@color/veil_text_low"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchRuleActive"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:checked="true" 
                            app:thumbTint="@color/veil_switch_thumb"
                            app:trackTint="@color/veil_switch_track" />
                    </RelativeLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Independent Contact Lock Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="INDEPENDENT CONTACT LOCK"
                android:textColor="@color/veil_accent_secure"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/veil_surface_card"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/veil_hairline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_toStartOf="@+id/switchCustomPinEnabled"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Require Independent PIN"
                                android:textColor="@color/veil_text_high"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Set a dedicated password or PIN just for this contact's conversation"
                                android:textColor="@color/veil_text_low"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchCustomPinEnabled"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:checked="false"
                            app:thumbTint="@color/veil_switch_thumb"
                            app:trackTint="@color/veil_switch_track" />
                    </RelativeLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilContactLockPin"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Contact PIN (4-8 digits)"
                        android:visibility="gone"
                        app:boxBackgroundColor="@color/veil_surface_elevated"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxStrokeColor="@color/veil_accent_secure"
                        app:endIconMode="password_toggle"
                        app:hintTextColor="@color/veil_accent_secure"
                        app:startIconDrawable="@drawable/ic_lock_closed"
                        app:startIconTint="@color/veil_accent_secure">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etContactLockPin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberPassword"
                            android:maxLength="8"
                            android:textColor="@color/veil_text_high"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Save & Delete Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveRule"
                    style="@style/Widget.Veil.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Save Protection Rule"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteRule"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:text="Delete Rule"
                    android:textColor="@color/veil_accent_danger"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
