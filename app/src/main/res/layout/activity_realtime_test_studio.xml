<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/veil_canvas"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/veil_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_button_cyber_secondary"
            android:contentDescription="Back"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/veil_text_high" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.08"
                android:singleLine="true"
                android:text="Real-Time Test Studio"
                android:textColor="@color/veil_text_high"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.03"
                android:singleLine="true"
                android:text="Live Pipeline Simulation &amp; Interception Lab"
                android:textColor="@color/veil_text_medium"
                android:textSize="10.5sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Simulate"
            android:src="@drawable/ic_test_simulate"
            app:tint="@color/veil_accent_secure" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/veil_hairline" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- System Pipeline Health Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSystemHealth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/veil_surface_card"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/veil_hairline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivHealthDot"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/bg_circle_icon"
                            app:tint="@color/veil_accent_secure" />

                        <TextView
                            android:id="@+id/tvHealthStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="ENGINE ARMED &amp; LISTENING"
                            android:textColor="@color/veil_accent_secure"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnQuickFixAccess"
                            style="@style/Widget.Veil.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="32dp"
                            android:text="Rebind"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHealthDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Notification Access is granted • Real-time listener active"
                        android:textColor="@color/veil_text_medium"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Test Configuration Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/veil_surface_card"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/veil_hairline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. SELECT SOURCE MESSAGING APPLICATION"
                        android:textColor="@color/veil_text_medium"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- App Selector Chips -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupApp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipWhatsApp"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="WhatsApp"
                            android:textColor="@color/veil_text_high"
                            app:chipBackgroundColor="@color/veil_surface" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTelegram"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Telegram"
                            android:textColor="@color/veil_text_high"
                            app:chipBackgroundColor="@color/veil_surface" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSignal"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Signal"
                            android:textColor="@color/veil_text_high"
                            app:chipBackgroundColor="@color/veil_surface" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSms"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SMS / Messages"
                            android:textColor="@color/veil_text_high"
                            app:chipBackgroundColor="@color/veil_surface" />
                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="2. TARGET SENDER IDENTITY"
                        android:textColor="@color/veil_text_medium"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Quick Pick Chips from User's Protected Contacts -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupRules"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleSelection="true" />
                    </HorizontalScrollView>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:boxBackgroundColor="@color/veil_surface"
                        app:boxStrokeColor="@color/veil_hairline"
                        app:hintTextColor="@color/veil_text_medium">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSenderName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Sender Name (e.g. Alice, +1234567890)"
                            android:text="Secret Contact"
                            android:textColor="@color/veil_text_high"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="3. NOTIFICATION TYPE (DYNAMIC DECOY CATEGORY)"
                        android:textColor="@color/veil_text_medium"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupNotifType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTypeMessage"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="💬 Message"
                            android:textColor="@color/veil_text_high"
                            app:chipBackgroundColor="@color/veil_surface" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTypeCall"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📞 Voice Call"
                            android:textColor="@color/veil_text_high"
                            app:chipBackgroundColor="@color/veil_surface" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTypeMedia"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📎 Media / Photo"
                            android:textColor="@color/veil_text_high"
                            app:chipBackgroundColor="@color/veil_surface" />
                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="4. MESSAGE PAYLOAD"
                        android:textColor="@color/veil_text_medium"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:boxBackgroundColor="@color/veil_surface"
                        app:boxStrokeColor="@color/veil_hairline"
                        app:hintTextColor="@color/veil_text_medium">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMessageBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Message text to intercept &amp; disguise"
                            android:text="Hey, are you free right now? Need to discuss privately."
                            android:textColor="@color/veil_text_high"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Quick Sample Message Buttons (Scrollable for all screen widths) -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSample1"
                                style="@style/Widget.Veil.Button.Secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginEnd="6dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:paddingHorizontal="10dp"
                                android:text="Private Meeting"
                                android:textSize="11sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSample2"
                                style="@style/Widget.Veil.Button.Secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginEnd="6dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:paddingHorizontal="10dp"
                                android:text="Confidential File"
                                android:textSize="11sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSample3"
                                style="@style/Widget.Veil.Button.Secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:paddingHorizontal="10dp"
                                android:text="Call Request"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="4. TRIGGER DELAY (TIME TO SWITCH SCREEN / LOCK)"
                        android:textColor="@color/veil_text_medium"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupDelay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDelay0"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Instant (0s)"
                            android:textColor="@color/veil_text_high"
                            app:chipBackgroundColor="@color/veil_surface" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDelay3"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3s (Switch to Home)"
                            android:textColor="@color/veil_text_high"
                            app:chipBackgroundColor="@color/veil_surface" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDelay5"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5s (Lock Screen)"
                            android:textColor="@color/veil_text_high"
                            app:chipBackgroundColor="@color/veil_surface" />
                    </com.google.android.material.chip.ChipGroup>

                    <!-- Fire Test Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFireTest"
                        style="@style/Widget.Veil.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="16dp"
                        android:text="⚡ Fire Real-Time Test Alert"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_test_simulate"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconSize="16dp"
                        app:iconTint="@color/veil_button_primary_text" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Real-Time Pipeline Audit Log -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/veil_surface_card"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/veil_hairline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:letterSpacing="0.06"
                            android:text="LIVE PIPELINE EXECUTION AUDIT"
                            android:textColor="@color/veil_text_high"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnClearAudit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="Clear Log"
                            android:textColor="@color/veil_text_medium"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Real-time audit log of Android notification interception &amp; disguise"
                        android:textColor="@color/veil_text_medium"
                        android:textSize="11sp" />

                    <!-- Live Log Text Output -->
                    <TextView
                        android:id="@+id/tvAuditLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@color/veil_surface"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="3dp"
                        android:padding="12dp"
                        android:text="[Ready] Standby. Tap 'Fire Real-Time Test Alert' to observe live interception."
                        android:textColor="@color/veil_accent_secure"
                        android:textSize="11sp" />

                    <!-- Action shortcuts below log -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnViewChats"
                            style="@style/Widget.Veil.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="36dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="6dp"
                            android:singleLine="true"
                            android:text="View Protected Chats"
                            android:textSize="11sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnViewLog"
                            style="@style/Widget.Veil.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="36dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="6dp"
                            android:singleLine="true"
                            android:text="View Vault"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
